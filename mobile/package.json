{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@convex-dev/auth": "2.0.0-beta.0",
    "@expo/vector-icons": "^15.0.2",
    "convex": "1.46.0",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "dev": "expo start --dev-client",
    "device": "expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "verify:deps": "node scripts/verify-deps.mjs",
    "verify:bundle": "expo export --platform all --output-dir /tmp/pushupclub-verify-bundle && rm -rf /tmp/pushupclub-verify-bundle",
    "verify:eas": "bash scripts/verify-eas-bundle.sh",
    "preflight": "npm run typecheck && npm run verify:deps && npm run verify:bundle && npm run verify:eas",
    "ship:check": "bash ../scripts/tag-release.sh --check",
    "tag": "bash ../scripts/tag-release.sh",
    "build:ios": "npm run ship:check && npm run preflight && eas build --platform ios --profile production && npm run tag -- mobile-build",
    "build:preview": "npm run preflight && eas build --platform ios --profile preview",
    "submit:ios": "eas submit --platform ios",
    "ota:production": "npm run ship:check && npm run preflight && eas update --branch production && npm run tag -- mobile-ota",
    "ota:preview": "npm run preflight && eas update --branch preview",
    "ota:promote": "eas update:republish --branch preview --destination-branch production",
    "ota:rollback": "eas update:roll-back-to-embedded --branch production",
    "builds": "eas build:list --limit 5",
    "build:why": "bash scripts/build-error.sh"
  },
  "private": true
}
