{
  "expo": {
    "name": "Push Up Club",
    "slug": "push-up-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pushupclub",
    "backgroundColor": "#F4EFE5",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pushupclub.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pushupclub.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4EFE5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#8A3B2A"
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "convexUrl": "https://coordinated-labrador-130.ca-central-1.convex.cloud",
      "eas": {
        "projectId": "c3bf2f55-1f00-4346-a1d3-46757dd3facf"
      }
    },
    "owner": "huhongwei",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c3bf2f55-1f00-4346-a1d3-46757dd3facf"
    }
  }
}
